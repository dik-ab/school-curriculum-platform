---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません | School Curriculum" description="お探しのページは見つかりませんでした。">
  <main class="home-main" style="text-align: center; padding-top: 96px;">
    <p class="eyebrow">404 Not Found</p>
    <h1>ページが見つかりません</h1>
    <p class="lead" style="margin: 16px auto 28px;">
      URLが変更されたか、入力に誤りがある可能性があります。
    </p>
    <div class="hero-actions" style="justify-content: center;">
      <a class="primary-action" href="/">ホームに戻る</a>
      <a class="secondary-action" href="/#courses">コース一覧を見る</a>
    </div>
  </main>
</BaseLayout>
