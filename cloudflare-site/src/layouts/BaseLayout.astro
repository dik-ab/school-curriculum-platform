---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

const {
  title = 'School Curriculum',
  description = 'フルスタック・AI開発カリキュラム'
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23235643'/%3E%3Ctext x='16' y='21' font-size='15' text-anchor='middle' fill='white' font-family='Arial'%3ES%3C/text%3E%3C/svg%3E" />
  </head>
  <body>
    <SiteHeader />
    <slot />
    <script>
      // mermaidは自前バンドル(CDN障害時に図が生テキストのまま残るのを防ぐ)。
      // 図があるページだけdynamic importでチャンクを読み込む。
      const blocks = document.querySelectorAll('pre.mermaid');
      if (blocks.length > 0) {
        import('mermaid').then(({ default: mermaid }) => {
          mermaid.initialize({
            startOnLoad: false,
            securityLevel: 'loose',
            theme: 'default',
            flowchart: { htmlLabels: true, useMaxWidth: true },
            themeVariables: { fontSize: '15px' }
          });
          return mermaid.run({ nodes: Array.from(blocks) });
        }).catch((e) => {
          console.error('mermaid render failed', e);
        });
      }
    </script>
  </body>
</html>

